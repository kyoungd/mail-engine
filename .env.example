# Copy to .env for local dev. .env is gitignored; never commit real secrets.
# The Postgres container reads these; migrations and tests read the *_DATABASE_URL pair.
#
# This file is the ONLY place environment identity lives. Everything tracked by git
# (Makefile, code) is byte-identical across environments so it pulls clean on deploy;
# anything that differs between test and production belongs here or it will not
# survive `git pull`. Today that is: the *_DATABASE_URL pair, MEDUSA_READONLY_URL,
# and the SNAPSHOT_INBOX_ pair.

POSTGRES_USER=mailengine
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mailengine
POSTGRES_PORT=5433

# Read-only role (created at cluster init; SELECT-only, granted by migration 0002).
READONLY_USER=mailengine_ro
READONLY_PASSWORD=change_me_ro

# Owner connection: the only write path. Migrations run as this role.
OWNER_DATABASE_URL=postgresql://mailengine:change_me@localhost:5433/mailengine

# Read-only connection: the analysis bypass. Cannot write.
READONLY_DATABASE_URL=postgresql://mailengine_ro:change_me_ro@localhost:5433/mailengine

# NMC Medusa DB, read-only (close feed — docs/mail-engine-backup/nmc-close-feed-contract.md §1).
# Role medusa_nmc_ro: SELECT on exactly three tables (customer,
# nmc_sales_attribution, nmc_partner_code) — nothing else, no writes. Read by
# db/medusa.py ONLY; never by session.py/readonly.py. Left empty = the nightly
# skips the nmc feed and prints that it skipped it. Prod credential lives in
# nvermisscall PRD § Production connection strings once minted.
MEDUSA_READONLY_URL=

# Phase 3 — the partner DNC snapshot upload Worker (Architecture B). The Worker
# fronts R2 with its binding; mail-engine holds no bucket credentials. ABSENT =
# jobs.dnc_pull refuses to run. Set at Phase 5, when the Worker is deployed.
SNAPSHOT_INBOX_URL=
SNAPSHOT_INBOX_TOKEN=
