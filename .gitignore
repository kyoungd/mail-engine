.env
# Founder seed addresses (real home/office addresses) — env-specific, never committed.
# The committed template is config/seeds.example.json.
config/seeds.json
# Contact data — lists of real businesses and phone numbers. Same rule as
# ingestion-app-1/ and dnc-lists/: source and working lists live beside the
# repo, never in it. config/collected-template.csv style templates are fine;
# anything holding real rows is not.
*-leads.csv
docs/main_contacts.csv
docs/main-contacts-diff.csv

.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mutmut-cache
mutants/

# Session/working state, not product. This is DEVELOPMENT's current state —
# production has no use for dev session notes, and it churns every session.
# ⚠️ Untracked = no git history and no GitHub backup. If this box dies, it dies.
# Durable cross-environment knowledge (how to deploy, the two-env split, the
# test-suite guard, settled decisions) belongs in decisions.md / INSTALL.md /
# PRD.md — which stay tracked — NOT here.
docs/current-state.md

# wrangler local dev state and its throwaway secrets
.wrangler/
.dev.vars
